#. Plugin Name of the plugin
#: quotlet.php
msgid "Quotlet - Request a Quote for WooCommerce"
msgstr "Quotlet - zapytanie ofertowe dla WooCommerce"

#. Plugin URI of the plugin
#: quotlet.php
msgid "https://plogins.com/plogins-estimate/"
msgstr "https://plogins.com/plogins-estimate/"

#. Description of the plugin
#: quotlet.php
msgid ""
"Let customers request a quote instead of buying directly, ideal for B2B and "
"made-to-order."
msgstr ""
"Pozwól klientom wysłać zapytanie ofertowe zamiast kupować bezpośrednio, "
"idealne dla B2B i produktów na zamówienie."

#. Author of the plugin
#: quotlet.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: quotlet.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: quotlet.php:48
msgid "Quotlet requires WooCommerce to be installed and activated."
msgstr "Quotlet wymaga zainstalowanego i aktywnego WooCommerce."

#: src/Admin/ProductData.php:39 src/Admin/Settings.php:127
msgid "Enable quote requests"
msgstr "Włącz zapytania ofertowe"

#: src/Admin/ProductData.php:41
msgid ""
"Quote mode is set to \"all products\", so every product already shows an Add "
"to quote button."
msgstr ""
"Tryb zapytań ofertowych jest ustawiony na „wszystkie produkty”, więc każdy "
"produkt wyświetla już przycisk Dodaj do zapytania."

#: src/Admin/ProductData.php:42
msgid ""
"Hide the price and add-to-cart button and show an \"Add to quote\" button "
"instead."
msgstr ""
"Ukryj cenę i przycisk dodawania do koszyka, a zamiast nich pokaż przycisk "
"„Dodaj do zapytania”."

#: src/Admin/ProUpsell.php:85
